{
  "name": "superapp-pc2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node web/generate-icons.mjs && vite --config vite.config.ts",
    "api": "node api/server.mjs",
    "serve": "node api/host.mjs",
    "build": "node web/generate-icons.mjs && tsc --noEmit && vite build --config vite.config.ts && node web/build-pwa.mjs",
    "test": "node --test tests/*.test.mjs",
    "migrate": "node db/migrate.mjs",
    "seed": "node db/seed.mjs",
    "db:reset": "node db/seed.mjs --reset",
    "smoke": "node tests/smoke.mjs",
    "demo:district": "node db/export-demo-district.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
