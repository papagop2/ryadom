{
  "name": "Рядом: услуги города",
  "short_name": "Рядом",
  "description": "Городские услуги, записи, заказы и такси рядом.",
  "lang": "ru",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
