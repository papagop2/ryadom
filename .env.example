# Скопировать в .env или задать эти переменные службе API.
# Файл .env в репозиторий не попадает.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=rjadom
PGUSER=rjadom_app
PGPASSWORD=заменить-на-пароль-из-файла-вне-репозитория
HOST=127.0.0.1
PORT=3100
# Стенд без СМС: код входа возвращается в ответе и показывается в интерфейсе.
DEMO_LOGIN=1
# Секрет для хеширования сессий и кодов; сгенерировать на сервере, не коммитить.
SESSION_SECRET=заменить-на-случайную-строку
# Отдельная роль для db/migrate.mjs (владелец схемы).
# PGMIGRATOR_USER=rjadom_migrator
# PGMIGRATOR_PASSWORD=заменить-на-пароль-из-файла-вне-репозитория
# HTTPS-вход api/host.mjs: без TLS_PFX запускается по HTTP только для проверки.
# HOST=192.168.50.150
# PORT=443
# TLS_PFX=C:/Users/User/Desktop/netral2/secrets/rjadom-tls.pfx
# TLS_PFX_PASSPHRASE=заменить-на-пароль-из-файла-вне-репозитория
